---
const menu = [
  {
    name: 'CV',
    href: '/cv'
  },
  {
    name: 'Blog',
    href: '/blog'
  },
  {
    name: 'Projects',
    href: '/projects'
  },
];

const currentPath = Astro.url.pathname;
---
<style>
nav {
  display: flex;
  height: 64px;
  justify-content: space-between;
  align-items: center;
}

.wordmark {
  font-family: var(--font-mono);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.03em;
}

.wordmark span {
  color: var(--acid);
}

.wordmark:hover {
  color: var(--text);
  text-decoration: none;
}

ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 4px;
}

a {
  text-decoration: none;
}

.nav-link {
  padding: 7px 12px;
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--fg-secondary-color);
  text-decoration: none;
  transition: color var(--transition), background-color var(--transition);
}

.nav-link:hover {
  color: var(--text);
  background: rgb(255 255 255 / 0.05);
}

.nav-link.active {
  color: var(--acid);
}
</style>

<nav>
  <a href="/" class="wordmark" aria-label="Home">
    makmonty<span>_</span>
  </a>
  <ul>
    {menu.map(item => (
      <li>
        <a
          href={item.href}
          class:list={[ 'nav-link', { active: currentPath.startsWith(item.href) }]}
          aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
        >
          {item.name}
        </a>
      </li>
    ))}
  </ul>
</nav>
