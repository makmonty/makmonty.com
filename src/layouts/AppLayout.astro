---
import Layout from './Layout.astro';
import { type App } from '../types/content';

const { frontmatter: app } = Astro.props as { frontmatter: App };
---
<Layout title={app.title}>
  <article class="app-page">
    {app.featuredImage &&
      <div class="featured-image">
        <img src={app.featuredImage} alt={app.title}>
      </div>
    }
    <h1>{app.title}</h1>
    <div class="app-content">
      <!-- eslint-disable-next-line -->
      <div class="app-description">
        <slot />
      </div>
      <aside class="app-sidebar">
        {app.links?.length &&
          <div class="app-links">
            <h4>Links</h4>
            <ul>
              {app.links.map(link => (
                <li>
                  <a href={link.url}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        }
      </aside>
    </div>
  </article>
</Layout>

<style>
.app-page {
  margin: 48px 0;
}

.featured-image {
  text-align: center;
  margin-bottom: 32px;
}

.featured-image img {
  display: inline-block;
  width: 256px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle-color);
  box-shadow: var(--shadow-card);
}

.app-page h1 {
  margin: 0 0 32px;
}

.app-content {
  display: flex;
  gap: 48px;
}

.app-description {
  flex: 1;
  min-width: 0;
}

.app-sidebar {
  flex-shrink: 0;
  width: 200px;
}

.app-sidebar h4 {
  margin: 0 0 12px;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--fg-secondary-color);
}

.app-sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.app-links li {
  margin-bottom: 8px;
}

@media (max-width: 640px) {
  .app-content {
    flex-direction: column;
  }

  .app-sidebar {
    width: auto;
  }
}
</style>
