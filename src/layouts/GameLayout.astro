---
import Layout from './Layout.astro';
import { type Game } from '../types/content';

const { frontmatter: game } = Astro.props as { frontmatter: Game };
---
<Layout title={game.title}>
  <article class="game-page">
    {game.featuredImage &&
      <div class="featured-image">
        <img src={game.featuredImage} alt={game.title}>
      </div>
    }
    <h1>{game.title}</h1>
    <div class="game-content">
      <!-- eslint-disable-next-line -->
      <div class="game-description">
        <slot />
      </div>
      <aside class="game-sidebar">
        <h4>Available for</h4>
        <ul class="platforms">
          {game.platforms.map(platform => (
            <li>
              <i class={'lab la-' + platform} aria-label={platform} />
            </li>
          ))}
        </ul>
        {game.links?.length &&
          <div class="game-links">
            <h4>Links</h4>
            <ul>
              {game.links.map(link => (
                <li>
                  <a href={link.url}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        }
      </aside>
    </div>
  </article>
</Layout>

<style>
.game-page {
  margin: 48px 0;
}

.featured-image {
  text-align: center;
  margin-bottom: 32px;
}

.featured-image img {
  display: inline-block;
  width: 256px;
  border-radius: var(--radius-md);
  border: 1px solid var(--border-subtle-color);
  box-shadow: var(--shadow-card);
}

.game-page h1 {
  margin: 0 0 32px;
}

.game-content {
  display: flex;
  gap: 48px;
}

.game-description {
  flex: 1;
  min-width: 0;
}

.game-sidebar {
  flex-shrink: 0;
  width: 200px;
}

.game-sidebar h4 {
  margin: 0 0 12px;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--fg-secondary-color);
}

.game-sidebar ul {
  list-style: none;
  padding: 0;
  margin: 0 0 28px;
}

.platforms {
  display: flex;
  gap: 12px;
  font-size: 1.6rem;
  color: var(--fg-secondary-color);
}

.game-links li {
  margin-bottom: 8px;
}

@media (max-width: 640px) {
  .game-content {
    flex-direction: column;
  }

  .game-sidebar {
    width: auto;
  }
}
</style>
