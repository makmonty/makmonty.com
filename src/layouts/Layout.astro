---
import BlueskyIcon from '../images/bluesky.svg?raw';
import AppNav from '../components/AppNav.astro';
import 'line-awesome/dist/line-awesome/css/line-awesome.css';
import '../../styles/style.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const socialLinks = [
  {
    href: 'http://github.com/makmonty',
    title: 'Github',
    icon: 'github',
    showOnPrint: true,
  },
  {
    href: 'https://tkz.one/@makmonty',
    title: 'Mastodon',
    icon: 'mastodon',
    rel: 'me',
    showOnPrint: false,
  },
  //{
  //  href: 'https://bsky.app/profile/makmonty.itch.io',
  //  title: 'Bluesky',
  //  icon: BlueskyIcon,
  //  showOnPrint: false,
  //},
  {
    href: 'https://www.linkedin.com/in/angelbraseromoreno/',
    title: 'Linkedin',
    icon: 'linkedin',
    showOnPrint: true,
  },
  {
    href: 'https://soundcloud.com/angel-brasero-moreno',
    title: 'Soundcloud',
    icon: 'soundcloud',
    showOnPrint: false,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>

    <slot name="head" />

    <style>
      i span {
        font-size: 0;
      }

      .site-header {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--void);
        border-bottom: 1px solid var(--border-subtle-color);
      }

      .header-inner {
        max-width: 1024px;
        margin: 0 auto;
        padding: 0 32px;
      }

      .site-footer {
        margin-top: 140px;
        border-top: 1px solid var(--border-subtle-color);
      }

      .footer-inner {
        max-width: 1024px;
        margin: 0 auto;
        padding: 40px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
      }

      .site-footer h2 {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--fg-secondary-color);
        margin: 0;
      }

      .main-layout {
        max-width: 1024px;
        margin: 0 auto;
        padding: 32px 32px 0;
      }

      .social-links {
        display: flex;
        gap: 6px;

        a {
          display: flex;
          align-items: center;
          justify-content: center;
          width: 2.4rem;
          height: 2.4rem;
          font-size: 1.25em;
          text-decoration: none;
          color: var(--fg-secondary-color);
          border: 1px solid transparent;
          border-radius: var(--radius-sm);
          transition: color var(--transition), border-color var(--transition),
            background-color var(--transition), transform var(--transition);
        }

        a:hover {
          color: var(--acid);
          border-color: var(--border-color);
        }

        svg {
          width: 1em;
          height: auto;
        }
      }

      @media print {
        header {
          display: none;
        }
        @page {
          size: 210mm 297mm; /* landscape */
          margin: 0; /* this affects the margin in the printer settings */
        }
        body {
          margin: 30px 15px;
        }
        footer {
          margin: 0;

          &.site-footer {
            border-top: none;
          }

          .footer-inner {
            padding: 0;
            display: block;
          }

          .social-links a {
            color: #444;
          }

          h2 {
            display: none;
          }
          .social-link {
            display: none;
            font-family: inherit;
            font-size: 16px;

            i {
              font-size: inherit;
              font-family: inherit;

              &::before {
                display: none;
              }

              span {
                font-size: inherit;
                font-family: inherit;
              }
            }

            &.show-print {
              display: inline-block;
            }
          }
        }
      }
    </style>
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <AppNav />
      </div>
    </header>

    <main class="main-layout">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <h2>Find me at...</h2>
        <div class="social-links">
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                title={link.title}
                rel={link.rel}
                class:list={[
                  'social-link',
                  link.showOnPrint ? 'show-print' : '',
                ]}
              >
                {link.icon.includes('<svg') ? (
                  <Fragment set:html={link.icon} />
                ) : (
                  <i class:list={[ 'lab', 'la-' + link.icon ]}>
                    <span>{link.title}</span>
                  </i>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </footer>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.href = '/admin/';
            });
          }
        });
      }
    </script>
  </body>
</html>
