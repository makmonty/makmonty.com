---
import { type MarkdownInstance } from 'astro';
import Layout from '@/layouts/Layout.astro';
import BaseButton from '@/components/BaseButton.astro';
import { type BlogPost } from '@/types/content';
import BlogPostItem from '@/components/BlogPostItem.astro';

const yearsOfExperience = new Date().getFullYear() - 2010;

let blogPosts: Array<MarkdownInstance<BlogPost>> = [];
try {
  blogPosts = Object.values(import.meta.glob('./blog/*.md', { eager: true }));
} catch {
  console.log('No blog posts');
}
---
<Layout title="makmonty">
  <article>
    <section class="intro">
      <p class="prompt"><span class="prompt-sign">$</span> whoami</p>
      <h1>
        Ángel<br>Brasero<span class="cursor" aria-hidden="true"></span>
      </h1>
      <p class="summary">
        Software engineer. Passionate about technology, software development, music, 3D printing...
        And above all that: my family.
      </p>
      <ul class="meta">
        <li>{yearsOfExperience}+ yrs experience</li>
        <li>frontend</li>
        <li>backend</li>
        <li>games</li>
      </ul>
      <div class="intro-actions">
        <BaseButton href="/cv" accent="secondary">
          Check my CV
        </BaseButton>
        <BaseButton href="/projects">
          See my projects
        </BaseButton>
      </div>
    </section>
    {!!blogPosts?.length && (
      <section>
        <h2 class="section-title"><span class="section-index">01</span> Blog</h2>
        {blogPosts.map(post => (
          <BlogPostItem post={post} />
        ))}
      </section>
    )}
  </article>
</Layout>

<style>
.intro {
  margin: 96px 0 120px;
  border-top: 1px solid var(--border-subtle-color);
  padding-top: 64px;
}

.prompt {
  font-family: var(--font-mono);
  font-size: 0.95rem;
  color: var(--muted);
  margin: 0 0 16px;
}

.prompt-sign {
  color: var(--acid);
  margin-right: 8px;
}

.intro h1 {
  margin: 0;
  font-size: clamp(3.4rem, 11vw, 7.5rem);
  font-weight: 800;
  line-height: 0.95;
  letter-spacing: -0.045em;
  text-transform: uppercase;
}

.cursor {
  display: inline-block;
  width: 0.55em;
  height: 0.82em;
  margin-left: 0.08em;
  background: var(--acid);
  animation: blink 1.1s steps(1) infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .cursor {
    animation: none;
  }
}

.intro .summary {
  margin: 32px 0 24px;
  color: var(--text-soft);
  font-size: 1.15rem;
  max-width: 52ch;
}

.meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 24px;
  list-style: none;
  padding: 0;
  margin: 0 0 40px;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--muted);
}

.meta li::before {
  content: '//';
  color: var(--acid);
  margin-right: 8px;
}

.intro-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

section:not(:first-child) {
  margin-bottom: 72px;
}

.section-title {
  display: flex;
  align-items: baseline;
  gap: 16px;
  margin: 0 0 28px;
  padding-top: 20px;
  border-top: 1px solid var(--border-subtle-color);
  font-size: 1.5rem;
}

.section-index {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--acid);
}

@media (max-width: 700px) {
  .intro {
    margin: 56px 0 88px;
    padding-top: 48px;
  }
}
</style>
